# Copiar a .env y ajustar. En Docker se inyectan como environment.

# PostgreSQL es obligatorio para ejecutar la app y las migraciones.
DATABASE_URL=postgresql+psycopg://budget:budget@localhost:5432/budget

# Cambiar en producción (>= 32 bytes, p. ej. `openssl rand -hex 32`).
# Déjalo vacío en local: en desarrollo (APP_ENV != production) el backend
# arranca igual; en production con valor débil fallará el arranque.
JWT_SECRET=

# Escáner de tickets con IA via OpenRouter (opcional; sin key → 501)
# Consigue tu key en https://openrouter.ai/keys
# OPENROUTER_API_KEY=
# OPENROUTER_MODEL=google/gemini-3.6-flash
