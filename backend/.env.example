# Copiar a .env y ajustar. En Docker se inyectan como environment.

# SQLite en dev local; Postgres en docker/prod
DATABASE_URL=sqlite:///./dev.db
# DATABASE_URL=postgresql+psycopg://budget:budget@localhost:5432/budget

# Cambiar en producción (>= 32 bytes)
JWT_SECRET=dev-secret-change-me

# Escáner de tickets con IA (opcional; sin key → endpoint responde 501)
# GEMINI_API_KEY=
