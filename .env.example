# Copiar a .env (ignorado por git). Lo lee docker-compose.yml y lo inyecta como
# environment en los contenedores; los valores por defecto del compose sirven
# para probar en local, pero no para un despliegue real.

# Firma de los JWT. Generar con: openssl rand -hex 32
# Cambiarlo invalida las sesiones activas (todos vuelven a entrar).
JWT_SECRET=

# Security limits for one backend process. Requests exceeding a limit receive
# 429. These counters are intentionally process-local; do not run multiple
# backend replicas expecting a shared limit.
# AUTH_REGISTER_LIMIT=5
# AUTH_REGISTER_WINDOW_SECONDS=3600
# AUTH_LOGIN_LIMIT=10
# AUTH_LOGIN_WINDOW_SECONDS=60
# AUTH_JOIN_LIMIT=10
# AUTH_JOIN_WINDOW_SECONDS=60
# TICKET_SCAN_LIMIT=10
# TICKET_SCAN_WINDOW_SECONDS=3600
# MAX_MEMBERS_PER_HOUSEHOLD=10
# MAX_ACTIVE_INVITATIONS_PER_HOUSEHOLD=5

# Comma-separated browser origins allowed to call the API. In a public
# deployment set this to the exact HTTPS frontend origin, for example:
# CORS_ORIGINS=["https://budget.example.com"]
# Never use * with credentialed JWT requests.
# CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]

# Escáner de tickets con IA vía OpenRouter (opcional; sin key el endpoint
# responde 501 y el resto de la app funciona igual).
# Consigue tu key en https://openrouter.ai/keys
OPENROUTER_API_KEY=
# OPENROUTER_MODEL=google/gemini-3.6-flash

# Credenciales de MinIO (comprobantes adjuntos). Si se omiten, el compose usa
# minioadmin / minioadmin123: cambiarlas fuera de local.
# MINIO_ROOT_USER=
# MINIO_ROOT_PASSWORD=

# Backend logs are JSON. Use DEBUG only while diagnosing a problem; production
# should remain at INFO to avoid excessive output.
# LOG_LEVEL=INFO
